<?xml version="1.0"?>
<robot name="pinchy_arm">
  <group name="arm"><chain base_link="base_link" tip_link="pointer_tip"/></group>
  <group_state name="zero" group="arm">
    <joint name="shoulder_pan" value="0"/><joint name="shoulder_lift" value="0"/>
    <joint name="elbow_flex" value="0"/><joint name="wrist_flex" value="0"/>
    <joint name="wrist_roll" value="0"/><joint name="pen_pitch" value="0"/>
  </group_state>
  <!-- Only mechanically connected neighboring bodies are excluded.
       No random-sampling 'never collides' pairs or whole-arm/object exclusions. -->
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_pitch_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_pitch_link" link2="wrist_roll_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_roll_link" link2="pen_holder_link" reason="Adjacent"/>
</robot>
